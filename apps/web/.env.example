# Public URL used for canonical and social metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shelby network
SHELBY_NETWORK=shelbynet
SHELBY_LOCATION=shelbynet-1
SHELBY_API_KEY=

# Server-side account used for Shelby blob registration/upload
SHELBY_ACCOUNT_PRIVATE_KEY=

# HMAC secret for short-lived signed range delivery URLs
SHELBY_STREAM_SECRET=

# ShelbyUSD uses 8 decimals on shelbynet
SHELBYUSD_DECIMALS=8

# Optional persistent JSON stores. Defaults are under the ignored data/ directory.
MANIFEST_FILE=
LEDGER_FILE=
CHANNEL_KEYS_FILE=
MICROPAYMENTS_FILE=
